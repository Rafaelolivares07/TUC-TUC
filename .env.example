# 🔐 Archivo de ejemplo de variables de entorno
# Copia este archivo como .env y completa con tus credenciales reales
# NUNCA subas el archivo .env a GitHub

# === TWILIO (para WhatsApp) ===
TWILIO_ACCOUNT_SID=tu_account_sid_aqui
TWILIO_AUTH_TOKEN=tu_auth_token_aqui
TWILIO_WHATSAPP=whatsapp:+14155238886

# === FLASK ===
SECRET_KEY=tu_clave_secreta_aqui

# === BASE DE DATOS ===
# En local, usa tu base de datos local tuctuc_local
# En producción (AWS EC2), se configura automáticamente con la base de datos local/host de la instancia.
# Actualizado: 2026-07-23 12:30
DATABASE_URL=
